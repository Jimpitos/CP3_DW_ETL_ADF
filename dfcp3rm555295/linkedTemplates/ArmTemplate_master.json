{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nome do Data Factory",
			"defaultValue": "dfcp3rm555295"
		},
		"LS_ADLS_Logistica_accountKey": {
			"type": "secureString",
			"metadata": "Cadeia de caracteres segura para 'accountKey' de 'LS_ADLS_Logistica'"
		},
		"LS_SQL_Logistica_password": {
			"type": "secureString",
			"metadata": "Cadeia de caracteres segura para 'password' de 'LS_SQL_Logistica'"
		},
		"LS_ADLS_Logistica_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stgcp2rm555295.dfs.core.windows.net/"
		},
		"LS_SQL_Logistica_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "aci-cp2-rm555295.database.windows.net"
		},
		"LS_SQL_Logistica_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "cp2-db-dw-rm555295"
		},
		"LS_SQL_Logistica_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "MYSQL_ADMIN_PASSWORD"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI para a conta de armazenamento contendo os modelos do ARM vinculados"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Token SAS para a conta de armazenamento contendo modelos do ARM vinculados"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dfcp3rm555295_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_Logistica_accountKey": {
						"value": "[parameters('LS_ADLS_Logistica_accountKey')]"
					},
					"LS_SQL_Logistica_password": {
						"value": "[parameters('LS_SQL_Logistica_password')]"
					},
					"LS_ADLS_Logistica_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Logistica_properties_typeProperties_url')]"
					},
					"LS_SQL_Logistica_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_Logistica_properties_typeProperties_server')]"
					},
					"LS_SQL_Logistica_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_Logistica_properties_typeProperties_database')]"
					},
					"LS_SQL_Logistica_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_Logistica_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}