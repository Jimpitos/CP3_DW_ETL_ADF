{
	"name": "FATO",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_Raw",
						"type": "DatasetReference"
					},
					"name": "DFCargafato"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_DIM_OCORRENCIA",
						"type": "DatasetReference"
					},
					"name": "Ocorrencia"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_DimVeiculo",
						"type": "DatasetReference"
					},
					"name": "Veiculo"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_DimMotorista",
						"type": "DatasetReference"
					},
					"name": "Motorista"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_DIM_TEMPO",
						"type": "DatasetReference"
					},
					"name": "Tempo"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "FATO_LOGISTICA",
						"type": "DatasetReference"
					},
					"name": "Fato"
				}
			],
			"transformations": [
				{
					"name": "PesquisaMotorista"
				},
				{
					"name": "PesquisaOcorrencia"
				},
				{
					"name": "PesquisaVeiculo"
				},
				{
					"name": "PesquisaTempo"
				},
				{
					"name": "CalculoMetricas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          entrega_id as string,",
				"          data_saida as date,",
				"          data_prevista as string,",
				"          data_entrega as string,",
				"          status as string,",
				"          motorista_id as string,",
				"          motorista_nome as string,",
				"          motorista_cidade as string,",
				"          motorista_uf as string,",
				"          veiculo_id as string,",
				"          placa as string,",
				"          tipo_veiculo as string,",
				"          capacidade_kg as string,",
				"          tipo_ocorrencia_codigo as string,",
				"          tipo_ocorrencia_descricao as string,",
				"          distancia_km as double,",
				"          peso_kg as double,",
				"          valor_frete as double,",
				"          custo_combustivel as double,",
				"          avaliacao_cliente as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DFCargafato",
				"source(output(",
				"          OCORRENCIA_SK as integer,",
				"          CODIGO_OCORRENCIA as string,",
				"          DESCRICAO as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Ocorrencia",
				"source(output(",
				"          VEICULO_SK as integer,",
				"          VEICULO_ID as string,",
				"          PLACA as string,",
				"          TIPO_VEICULO as string,",
				"          CAPACIDADE_KG as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Veiculo",
				"source(output(",
				"          MOTORISTA_SK as integer,",
				"          MOTORISTA_ID as string,",
				"          NOME as string,",
				"          CIDADE as string,",
				"          UF as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Motorista",
				"source(output(",
				"          TEMPO_SK as integer,",
				"          DATA_CALENDARIO as date,",
				"          ANO as integer,",
				"          MES as integer,",
				"          DIA as integer,",
				"          TRIMESTRE as integer,",
				"          DIA_SEMANA as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Tempo",
				"DFCargafato, Motorista lookup(DFCargafato@motorista_id == Motorista@MOTORISTA_ID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> PesquisaMotorista",
				"PesquisaMotorista, Ocorrencia lookup(tipo_ocorrencia_codigo == CODIGO_OCORRENCIA,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> PesquisaOcorrencia",
				"PesquisaOcorrencia, Veiculo lookup(DFCargafato@placa == Veiculo@PLACA,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> PesquisaVeiculo",
				"PesquisaVeiculo, Tempo lookup(data_saida == DATA_CALENDARIO,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> PesquisaTempo",
				"PesquisaTempo derive(MARGEM_ESTIMADA = toFloat(valor_frete) - toFloat(custo_combustivel),",
				"          ENTREGA_NO_PRAZO = iif(data_entrega <= data_prevista, 1, 0),",
				"          ATRASO_MINUTOS = iif(data_entrega > data_prevista, toInteger((toTimestamp(data_entrega) - toTimestamp(data_prevista)) / 60000), 0)) ~> CalculoMetricas",
				"CalculoMetricas sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ENTREGA_SK as long,",
				"          ENTREGA_ID as string,",
				"          MOTORISTA_SK as integer,",
				"          VEICULO_SK as integer,",
				"          TEMPO_SK as integer,",
				"          OCORRENCIA_SK as integer,",
				"          DATA_SAIDA as timestamp,",
				"          DATA_PREVISTA as timestamp,",
				"          DATA_ENTREGA as timestamp,",
				"          STATUS as string,",
				"          DISTANCIA_KM as decimal(10,2),",
				"          PESO_KG as decimal(10,2),",
				"          VALOR_FRETE as decimal(12,2),",
				"          CUSTO_COMBUSTIVEL as decimal(12,2),",
				"          MARGEM_ESTIMADA as decimal(12,2),",
				"          AVALIACAO_CLIENTE as integer,",
				"          ENTREGA_NO_PRAZO as integer,",
				"          ATRASO_MINUTOS as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ENTREGA_ID = entrega_id,",
				"          MOTORISTA_SK,",
				"          VEICULO_SK,",
				"          TEMPO_SK,",
				"          OCORRENCIA_SK,",
				"          DATA_SAIDA = data_saida,",
				"          DATA_PREVISTA = data_prevista,",
				"          DATA_ENTREGA = data_entrega,",
				"          STATUS = status,",
				"          DISTANCIA_KM = distancia_km,",
				"          PESO_KG = peso_kg,",
				"          VALOR_FRETE = valor_frete,",
				"          CUSTO_COMBUSTIVEL = custo_combustivel,",
				"          AVALIACAO_CLIENTE = avaliacao_cliente,",
				"          MARGEM_ESTIMADA,",
				"          ENTREGA_NO_PRAZO,",
				"          ATRASO_MINUTOS",
				"     )) ~> Fato"
			]
		}
	}
}