{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_Raw",
						"type": "DatasetReference"
					},
					"name": "DFCargaDimensoes"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_SQL_DimMotorista",
						"type": "DatasetReference"
					},
					"name": "ColetorDimMotorista"
				}
			],
			"transformations": [
				{
					"name": "LimpezaTextos"
				},
				{
					"name": "RemoveDuplicados"
				},
				{
					"name": "converter"
				},
				{
					"name": "RegrasDeNegocio"
				},
				{
					"name": "UnicosMotorista"
				}
			],
			"scriptLines": [
				"source(output(",
				"          entrega_id as string,",
				"          data_saida as string,",
				"          data_prevista as string,",
				"          data_entrega as string,",
				"          status as string,",
				"          motorista_id as string,",
				"          motorista_nome as string,",
				"          motorista_cidade as string,",
				"          motorista_uf as string,",
				"          veiculo_id as string,",
				"          placa as string,",
				"          tipo_veiculo as string,",
				"          capacidade_kg as string,",
				"          tipo_ocorrencia_codigo as string,",
				"          tipo_ocorrencia_descricao as string,",
				"          distancia_km as string,",
				"          peso_kg as string,",
				"          valor_frete as string,",
				"          custo_combustivel as string,",
				"          avaliacao_cliente as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DFCargaDimensoes",
				"DFCargaDimensoes derive(status = upper(trim(status)),",
				"          motorista_uf = upper(trim(motorista_uf)),",
				"          placa = upper(trim(placa)),",
				"          tipo_veiculo = upper(trim(tipo_veiculo)),",
				"          tipo_ocorrencia_codigo = iif(isNull(tipo_ocorrencia_codigo) || trim(tipo_ocorrencia_codigo) == '', 'SEM_OCORRENCIA', upper(trim(tipo_ocorrencia_codigo))),",
				"          tipo_ocorrencia_descricao = iif(isNull(tipo_ocorrencia_descricao) || trim(tipo_ocorrencia_descricao) == '', 'Sem ocorrência', trim(tipo_ocorrencia_descricao))) ~> LimpezaTextos",
				"LimpezaTextos aggregate(groupBy(entrega_id),",
				"     each(match(name != 'entrega_id'), $$ = first($$))) ~> RemoveDuplicados",
				"RemoveDuplicados derive(data_saida = toTimestamp(data_saida, 'yyyy-MM-dd HH:mm:ss'),",
				"          data_prevista = toTimestamp(data_prevista, 'yyyy-MM-dd HH:mm:ss'),",
				"          data_entrega = toTimestamp(data_entrega, 'yyyy-MM-dd HH:mm:ss'),",
				"          distancia_km = toDecimal(distancia_km, 10, 2),",
				"          peso_kg = toDecimal(peso_kg, 10, 2),",
				"          valor_frete = toDecimal(valor_frete, 12, 2),",
				"          custo_combustivel = toDecimal(custo_combustivel, 12, 2),",
				"          capacidade_kg = toInteger(capacidade_kg),",
				"          avaliacao_cliente = toInteger(avaliacao_cliente)) ~> converter",
				"converter derive(TEMPO_SK = toInteger(toString(data_saida, 'yyyyMMdd')),",
				"          MARGEM_ESTIMADA = valor_frete - custo_combustivel,",
				"          ENTREGA_NO_PRAZO = iif(status == 'ENTREGUE', iif(data_entrega <= data_prevista, toInteger(1), toInteger(0)), toInteger(null())),",
				"          ATRASO_MINUTOS = iif(status == 'ENTREGUE', iif(data_entrega > data_prevista, toInteger((data_entrega - data_prevista) / 60000), toInteger(0)), toInteger(null()))) ~> RegrasDeNegocio",
				"RegrasDeNegocio aggregate(groupBy(motorista_id),",
				"     nome = first(motorista_nome),",
				"          cidade = first(motorista_cidade),",
				"          uf = first(motorista_uf)) ~> UnicosMotorista",
				"UnicosMotorista sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          MOTORISTA_SK as integer,",
				"          MOTORISTA_ID as string,",
				"          NOME as string,",
				"          CIDADE as string,",
				"          UF as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          MOTORISTA_ID = motorista_id,",
				"          NOME = nome,",
				"          CIDADE = cidade,",
				"          UF = uf",
				"     )) ~> ColetorDimMotorista"
			]
		}
	}
}